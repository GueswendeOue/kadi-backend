{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "OPTIONS": []
  },
  "screens": [
    {
      "id": "OPTIONS",
      "title": "Autres détails",
      "terminal": true,
      "success": true,
      "data": {
        "flow_token": {
          "type": "string",
          "__example__": "opaque-flow-token"
        },
        "draft_id": {
          "type": "string",
          "__example__": "draft-example"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "options_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Derniers détails"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "tax_status",
                "label": "Situation fiscale",
                "required": false,
                "data-source": [
                  {
                    "id": "not_applicable",
                    "title": "Non applicable"
                  },
                  {
                    "id": "exempt",
                    "title": "Exonéré"
                  },
                  {
                    "id": "taxable",
                    "title": "Taxable"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "tax_rate",
                "label": "Taux de taxe (%)",
                "input-type": "number",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "discount_amount",
                "label": "Remise FCFA",
                "input-type": "number",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "amount_paid",
                "label": "Montant payé",
                "input-type": "number",
                "required": false
              },
              {
                "type": "DatePicker",
                "name": "due_date",
                "label": "Date d'échéance",
                "required": false
              },
              {
                "type": "Dropdown",
                "name": "payment_method",
                "label": "Mode de paiement",
                "required": false,
                "data-source": [
                  {
                    "id": "cash",
                    "title": "Espèces"
                  },
                  {
                    "id": "mobile_money",
                    "title": "Mobile Money"
                  },
                  {
                    "id": "bank_transfer",
                    "title": "Virement"
                  },
                  {
                    "id": "cheque",
                    "title": "Chèque"
                  },
                  {
                    "id": "other",
                    "title": "Autre"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "payment_terms",
                "label": "Conditions paiement",
                "input-type": "text",
                "required": false
              },
              {
                "type": "TextArea",
                "name": "invoice_note",
                "label": "Note",
                "required": false
              },
              {
                "type": "Footer",
                "label": "Vérifier le brouillon",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "outcome": "options_saved",
                    "flow_token": "${data.flow_token}",
                    "draft_id": "${data.draft_id}",
                    "tax_status": "${form.tax_status}",
                    "tax_rate": "${form.tax_rate}",
                    "discount_amount": "${form.discount_amount}",
                    "amount_paid": "${form.amount_paid}",
                    "due_date": "${form.due_date}",
                    "payment_method": "${form.payment_method}",
                    "payment_terms": "${form.payment_terms}",
                    "invoice_note": "${form.invoice_note}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
