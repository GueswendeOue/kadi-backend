        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "client_type",
                "label": "Type de client",
                "required": true,
                "data-source": [
                  { "id": "individual", "title": "Particulier" },
                  { "id": "professional", "title": "Professionnel" }
                ]
              },
              {
                "type": "TextInput",
                "name": "client_name",
                "label": "Nom",
                "helper-text": "Nom du client",
                "input-type": "text",
                "required": true,
                "max-chars": 200
              },
              {
                "type": "TextInput",
                "name": "client_phone",
                "label": "Téléphone",
                "helper-text": "Facultatif",
                "input-type": "phone",
                "required": false,
                "max-chars": 50
              },
              {
                "type": "TextInput",
                "name": "client_address",
                "label": "Adresse",
                "helper-text": "Facultatif",
                "input-type": "text",
                "required": false,
                "max-chars": 300
              },
              {
                "type": "TextInput",
                "name": "client_ifu",
                "label": "IFU professionnel",
                "helper-text": "IFU du client professionnel",
                "input-type": "text",
                "required": false,
                "max-chars": 100
              },
              {
                "type": "TextInput",
                "name": "client_registry_number",
                "label": "RCCM ou registre",
                "helper-text": "RCCM ou registre professionnel",
                "input-type": "text",
                "required": false,
                "max-chars": 150
              },
              {
                "type": "TextInput",
                "name": "invoice_subject",
                "label": "Objet",
                "helper-text": "Objet de la facture (facultatif)",
                "input-type": "text",
                "required": false,
                "max-chars": 300
              },
              {
                "type": "DatePicker",
                "name": "transaction_date",
                "label": "Date de transaction",
                "helper-text": "Vente ou prestation (facultatif)",
                "required": false
              },
              {
                "type": "Footer",
                "label": "Continuer",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "ARTICLES_UN_TROIS" },
                  "payload": {
                    "client_type": "${form.client_type}",
                    "client_name": "${form.client_name}",
                    "client_phone": "${form.client_phone}",
                    "client_address": "${form.client_address}",
                    "client_ifu": "${form.client_ifu}",
                    "client_registry_number": "${form.client_registry_number}",
                    "invoice_subject": "${form.invoice_subject}",
                    "transaction_date": "${form.transaction_date}"
                  }
                }
              }
            ]
          }
        ]
      }
