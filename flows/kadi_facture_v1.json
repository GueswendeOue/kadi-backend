                "label": "Taux de taxe (%)",
                "helper-text": "Taux de taxe en pourcentage, si taxable",
                "input-type": "number",
                "required": false,
                "max-chars": 6
              },
              {
                "type": "TextInput",
                "name": "discount_amount",
                "label": "Remise en FCFA",
                "input-type": "number",
                "required": false,
                "max-chars": 16
              },
              {
                "type": "TextInput",
                "name": "amount_paid",
                "label": "Montant déjà payé",
                "input-type": "number",
                "required": false,
                "max-chars": 16
              },
              {
                "type": "DatePicker",
                "name": "due_date",
                "label": "Date d’échéance",
                "required": false
              },
              {
                "type": "Dropdown",
                "name": "payment_method",
                "label": "Mode de paiement",
                "required": false,
                "data-source": [
                  { "id": "cash", "title": "Espèces" },
                  { "id": "mobile_money", "title": "Mobile Money" },
                  { "id": "bank_transfer", "title": "Virement" },
                  { "id": "cheque", "title": "Chèque" },
                  { "id": "other", "title": "Autre" }
                ]
              },
              {
                "type": "TextArea",
                "name": "payment_terms",
                "label": "Conditions paiement",
                "helper-text": "Conditions de paiement",
                "required": false
              },
              {
                "type": "TextArea",
                "name": "invoice_note",
                "label": "Note",
                "required": false
              },
              {
                "type": "RadioButtonsGroup",
                "name": "add_stamp",
                "label": "Ajouter mon tampon",
                "required": true,
                "data-source": [
                  { "id": "no", "title": "Non" },
                  { "id": "yes", "title": "Oui" }
                ]
              },
              {
                "type": "Footer",
                "label": "Envoyer à Kadi",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "client_type": "${data.client_type}",
                    "client_name": "${data.client_name}",
                    "client_phone": "${data.client_phone}",
                    "client_address": "${data.client_address}",
                    "client_ifu": "${data.client_ifu}",
                    "client_registry_number": "${data.client_registry_number}",
                    "invoice_subject": "${data.invoice_subject}",
                    "transaction_date": "${data.transaction_date}",
                    "item_1_designation": "${data.item_1_designation}",
                    "item_1_quantity": "${data.item_1_quantity}",
                    "item_1_unit": "${data.item_1_unit}",
                    "item_1_unit_price": "${data.item_1_unit_price}",
                    "item_2_designation": "${data.item_2_designation}",
                    "item_2_quantity": "${data.item_2_quantity}",
                    "item_2_unit": "${data.item_2_unit}",
                    "item_2_unit_price": "${data.item_2_unit_price}",
                    "item_3_designation": "${data.item_3_designation}",
                    "item_3_quantity": "${data.item_3_quantity}",
                    "item_3_unit": "${data.item_3_unit}",
                    "item_3_unit_price": "${data.item_3_unit_price}",
                    "item_4_designation": "${data.item_4_designation}",
                    "item_4_quantity": "${data.item_4_quantity}",
                    "item_4_unit": "${data.item_4_unit}",
                    "item_4_unit_price": "${data.item_4_unit_price}",
                    "item_5_designation": "${data.item_5_designation}",
                    "item_5_quantity": "${data.item_5_quantity}",
                    "item_5_unit": "${data.item_5_unit}",
                    "item_5_unit_price": "${data.item_5_unit_price}",
                    "item_6_designation": "${data.item_6_designation}",
                    "item_6_quantity": "${data.item_6_quantity}",
                    "item_6_unit": "${data.item_6_unit}",
                    "item_6_unit_price": "${data.item_6_unit_price}",
                    "has_more_items": "${data.has_more_items}",
                    "tax_status": "${form.tax_status}",
                    "tax_rate": "${form.tax_rate}",
                    "discount_amount": "${form.discount_amount}",
                    "amount_paid": "${form.amount_paid}",
                    "due_date": "${form.due_date}",
                    "payment_method": "${form.payment_method}",
                    "payment_terms": "${form.payment_terms}",
                    "invoice_note": "${form.invoice_note}",
                    "add_stamp": "${form.add_stamp}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
