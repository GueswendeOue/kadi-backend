{
  "version": "7.3",
  "routing_model": {
    "DISCHARGE_DETAILS": []
  },
  "screens": [
    {
      "id": "DISCHARGE_DETAILS",
      "title": "Préparer la décharge",
      "terminal": true,
      "data": {
        "session_id": {
          "type": "string",
          "__example__": "session_example"
        },
        "content_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "MONEY",
              "title": "Argent"
            },
            {
              "id": "GOODS",
              "title": "Bien"
            },
            {
              "id": "DOCUMENT",
              "title": "Document"
            },
            {
              "id": "OTHER",
              "title": "Autre"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Renseignez les informations de la décharge."
          },
          {
            "type": "Form",
            "name": "kadi_form",
            "children": [
              {
                "type": "TextInput",
                "name": "giver",
                "label": "Personne qui remet",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "TextInput",
                "name": "recipient",
                "label": "Personne qui reçoit",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "transferred_content_type",
                "label": "Ce qui est remis",
                "required": true,
                "data-source": "${data.content_types}"
              },
              {
                "type": "TextInput",
                "name": "amount",
                "label": "Montant (si argent)",
                "required": false,
                "input-type": "number"
              },
              {
                "type": "TextInput",
                "name": "description",
                "label": "Description (si bien, document ou autre)",
                "required": false,
                "input-type": "text"
              },
              {
                "type": "TextInput",
                "name": "quantity",
                "label": "Quantité (si applicable)",
                "required": false,
                "input-type": "number"
              },
              {
                "type": "TextInput",
                "name": "reason",
                "label": "Motif",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "TextInput",
                "name": "observations",
                "label": "Observations",
                "required": false,
                "input-type": "text"
              },
              {
                "type": "Footer",
                "label": "Continuer",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "flow_key": "DISCHARGE_DETAILS",
                    "action": "SAVE_DETAILS",
                    "data": {
                      "giver": "${form.giver}",
                      "recipient": "${form.recipient}",
                      "transferred_content_type": "${form.transferred_content_type}",
                      "amount": "${form.amount}",
                      "description": "${form.description}",
                      "quantity": "${form.quantity}",
                      "reason": "${form.reason}",
                      "observations": "${form.observations}"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
