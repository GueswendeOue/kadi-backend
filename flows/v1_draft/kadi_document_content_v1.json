{
  "version": "7.3",
  "routing_model": {
    "DOCUMENT_CONTENT": []
  },
  "screens": [
    {
      "id": "DOCUMENT_CONTENT",
      "title": "Articles",
      "terminal": true,
      "data": {
        "session_id": {
          "type": "string",
          "__example__": "session_example"
        },
        "document_label": {
          "type": "string",
          "__example__": "Facture"
        },
        "items_summary": {
          "type": "string",
          "__example__": "Aucun article enregistré."
        },
        "content_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "START_ADD_CONTENT", "title": "Ajouter un article" },
            { "id": "FINISH_CONTENT", "title": "Terminer les articles" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.document_label}"
          },
          {
            "type": "TextBody",
            "text": "${data.items_summary}"
          },
          {
            "type": "Form",
            "name": "kadi_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "action",
                "label": "Que souhaitez-vous faire ?",
                "required": true,
                "data-source": "${data.content_actions}"
              },
              {
                "type": "Footer",
                "label": "Continuer",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "flow_key": "DOCUMENT_CONTENT",
                    "action": "${form.action}",
                    "data": {}
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
