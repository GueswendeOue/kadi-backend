{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "DOCUMENT_REVIEW": []
  },
  "screens": [
    {
      "id": "DOCUMENT_REVIEW",
      "title": "Vérifiez les informations",
      "terminal": true,
      "data": {
        "session_id": {
          "type": "string",
          "__example__": "session_example"
        },
        "review_summary": {
          "type": "string",
          "__example__": "Résumé du document à vérifier."
        },
        "review_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "VERIFY",
              "title": "C’est bon"
            },
            {
              "id": "EDIT_CLIENT",
              "title": "Modifier le client"
            },
            {
              "id": "EDIT_CONTENT",
              "title": "Modifier les articles"
            },
            {
              "id": "EDIT_OPTIONS",
              "title": "Modifier les options"
            },
            {
              "id": "CANCEL",
              "title": "Annuler"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.review_summary}"
          },
          {
            "type": "Form",
            "name": "kadi_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "action",
                "label": "Que souhaitez-vous faire ?",
                "required": true,
                "data-source": "${data.review_actions}"
              },
              {
                "type": "Footer",
                "label": "Continuer",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "flow_key": "DOCUMENT_REVIEW",
                    "action": "${form.action}",
                    "data": {}
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
