{
  "version": "7.3",
  "routing_model": {
    "ONBOARDING": []
  },
  "screens": [
    {
      "id": "ONBOARDING",
      "title": "Faisons connaissance",
      "terminal": true,
      "data": {
        "session_id": {
          "type": "string",
          "__example__": "session_example"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Bienvenue chez Kadi"
          },
          {
            "type": "TextBody",
            "text": "Indiquez seulement les informations utiles pour commencer. Votre numéro WhatsApp est déjà reconnu."
          },
          {
            "type": "Form",
            "name": "kadi_profile_form",
            "children": [
              {
                "type": "TextInput",
                "name": "owner_name",
                "label": "Votre nom ou prénom",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "TextInput",
                "name": "business_name",
                "label": "Nom de l’activité ou entreprise",
                "required": false,
                "input-type": "text"
              },
              {
                "type": "Footer",
                "label": "Enregistrer",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "session_id": "${data.session_id}",
                    "flow_key": "ONBOARDING",
                    "action": "START",
                    "data": {
                      "owner_name": "${form.owner_name}",
                      "business_name": "${form.business_name}"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
